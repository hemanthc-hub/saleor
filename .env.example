# ─────────────────────────────────────────────────────────────
# HegmaKart — Flask Operations API Environment Template
# Copy this file to .env: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Flask App Configuration ──
FLASK_ENV=development
SECRET_KEY=change_this_to_a_random_secret_key
DEBUG=True
PORT=5000
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Local PostgreSQL (dev_hegma database) ──
DB_NAME=dev_hegma
DB_USER_NAME=hegma
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432

# ── Saleor Core GraphQL Backend ──
GRAPHQL_API_URL=http://localhost:8000/graphql/
SALEOR_ACCOUNT_REDIRECT_URL=http://localhost:3000
SALEOR_CHANNEL=
HEGMA_AUTH_TOKEN="Bearer YOUR_SALEOR_STAFF_OR_APP_TOKEN"

# ── Review Cryptographic Signing Key ──
FLASK_SECRET_KEY=hegma-secure-review-signing-key

# ── Razorpay Payment Gateway (Test Mode) ──
RAZORPAY_URL=https://api.razorpay.com/v1/orders
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
RAZORPAY_AUTH_TOKEN="Basic placeholder"

# ── MSG91 SMS Gateway & DLT Template IDs ──
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_OTP_DLE_ID="1307165234397419583"
MSG91_ORDER_DLE_ID="1307165234361126499"
MSG91_ORDER_COD_DLE_ID="1307165951829477290"
MSG91_CANCEL_DLE_ID="1307171169100455845"
